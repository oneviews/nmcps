{
	"name": "nmcps",
	"type": "module",
	"version": "1.7.1",
	"private": true,
	"packageManager": "pnpm@12.9.1",
	"description": "Starter template for Nuxt 4 and Tauri 2",
	"author": "Nicola Spadari",
	"license": "MIT",
	"scripts": {
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "vue-tsc -b --pretty",
		"bump": "bumpp",
		"tauri": "tauri",
		"tauri:dev": "tsx scripts/tauri-dev.ts",
		"tauri:dev:ios": "tauri ios dev",
		"tauri:dev:android": "tauri android dev",
		"tauri:build": "tauri build",
		"tauri:build:debug": "tauri build --debug",
		"tauri:build:ios": "tauri ios build",
		"tauri:build:android": "tauri android build",
		"check:ui": "node scripts/check-ui.mjs",
		"check:doc-system": "tsx scripts/check-doc-system.ts"
	},
	"dependencies": {
		"@nuxt/content": "^3.16.2",
		"@nuxt/ui": "^4.11.3",
		"@nuxtjs/i18n": "^10.6.0",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/plugin-fs": "2.7.1",
		"@tauri-apps/plugin-notification": "2.7.0",
		"@tauri-apps/plugin-opener": "2.7.2",
		"@tauri-apps/plugin-os": "2.4.0",
		"@tauri-apps/plugin-shell": "2.5.0",
		"@tauri-apps/plugin-store": "2.5.0",
		"@tauri-apps/plugin-updater": "2.14.0",
		"better-sqlite3": "^13.0.3",
		"nuxt": "^4.6.1",
		"vue": "^3.5.43",
		"vue-router": "^5.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@iconify-json/carbon": "^1.2.28",
		"@nuxt/eslint": "^1.17.0",
		"@tauri-apps/cli": "2.12.3",
		"@types/node": "^26.6.3",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"bumpp": "^12.3.0",
		"eslint": "^10.12.0",
		"nuxt-svgo": "^5.3.0",
		"playwright": "^1.64.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.3.12"
	}
}
