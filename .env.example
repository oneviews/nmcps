APPLE_DEVELOPMENT_TEAM="12345"

# ============================================================
# BFF（Nitro）—— 见 NMCPS-ADR-0007
# ============================================================
# 上游 REST 基址（server-only；不会进入浏览器产物）
# 联调实测实例：`http://192.168.1.55:8888/api/v1`（就绪探针 `/health` → `/api/v1/health`）
NUXT_BFF_UPSTREAM_BASE=http://192.168.1.55:8888/api/v1

# 单次上游请求超时（毫秒，默认 15000）
NUXT_BFF_TIMEOUT_MS=15000

# 允许携带凭据跨域访问 BFF 的 Origin（逗号分隔；桌面 WebView 为 tauri:// 协议）
NUXT_BFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,http://tauri.localhost

# 上游就绪探针（GET /ready）：拼接在 upstreamBase 之后的路径 + 独立超时（毫秒）
NUXT_BFF_READINESS_PATH=/health
NUXT_BFF_READINESS_TIMEOUT_MS=2000

# ============================================================
# 认证会话（见 NMCPS-ADR-0011）
# ============================================================
# 双 cookie 名：访问令牌（Path=/）+ 刷新令牌（Path=/api/auth，仅认证路由可见）
NUXT_BFF_TOKEN_COOKIE_NAME=nmcps_at
NUXT_BFF_REFRESH_COOKIE_NAME=nmcps_rt

# 令牌有效期兜底（毫秒）：访问令牌优先用上游 expiresIn；刷新令牌上游不返回 TTL
NUXT_BFF_ACCESS_TTL_MS=1800000
NUXT_BFF_REFRESH_TTL_MS=604800000

# 仿真网络签名会话（NMCPS-ADR-0021）：至少 32 字节；不配置时 /api/lab/** 回
# 503 bff_auth_not_configured（普通登录不受影响）。轮换时把旧密钥放在 PREVIOUS，
# 旧 cookie 在会话过期前仍可通过验证。
NUXT_BFF_SESSION_SECRET=change-me-to-at-least-32-random-bytes
NUXT_BFF_SESSION_SECRET_PREVIOUS=
NUXT_BFF_SESSION_COOKIE_NAME=nmcps_sess
NUXT_BFF_SESSION_TTL_MS=604800000

# 桌面端：请求带 `x-nmcps-client: desktop` 时 /api/auth/login|refresh 在响应体回传 tokens
# （存 tauri-plugin-store），否则写 HttpOnly cookie。该请求头已加入 CORS 白名单。

# ============================================================
# Mininet 实验后端（只读 BFF 通道，见 NMCPS-ADR-0020）
# ============================================================
# 实验后端基址（server-only）。留空＝通道未启用（无租户上下文时返回 503 mininet_not_configured）。
# 部署时后端必须只监听 127.0.0.1 或受控内网；浏览器不得直连 8000。
NUXT_MININET_BASE_URL=http://127.0.0.1:8000

# 租户 → 实例注册表（JSON）。配置后 /api/lab/** 只按签名会话的 tenant_id 查表；
# 未命中返回 503 tenant_runtime_unavailable，绝不回退到 NUXT_MININET_BASE_URL。
# 例：{"t_a":{"baseUrl":"http://127.0.0.1:8000"},"t_b":{"baseUrl":"http://127.0.0.1:8001"}}
NUXT_MININET_INSTANCES=

# 单次出站超时（毫秒，默认 15000）
NUXT_MININET_TIMEOUT_MS=15000

# ============================================================
# 本地代理绕过（Node 24 的 NODE_USE_ENV_PROXY）
# ============================================================
# Node 24 在 NODE_USE_ENV_PROXY=1 时会让全局 fetch 读 http_proxy / https_proxy，
# 于是 http://127.0.0.1:8000 也被送去代理：代理侧解析 127.0.0.1 命中的是它自己的 HTTPS 监听，
# /api/lab/** 就会把 nginx 的 400 "The plain HTTP request was sent to HTTPS port" 当成上游错误
# （表现为仿真页全部接口 400，而 curl 直连 8000 正常）。
# 本机直连端点与局域网内真实上游都必须列进 NO_PROXY；与 scripts/check-ui.mjs、
# scripts/lib/bff-harness.mjs 的约定一致。联调实例 `192.168.1.55:8888` 属于内网直连，
# 漏掉它会让登录走公司代理并报 502 bff_upstream_unreachable。
NO_PROXY=127.0.0.1,localhost,192.168.1.55
no_proxy=127.0.0.1,localhost,192.168.1.55

# 前端访问 BFF 的基址：
# - web（同源部署）：留空
# - 桌面构建：必须填已部署的 BFF，如 https://nmcps.example.com
NUXT_PUBLIC_BFF_BASE=

# 登录页是否提供「实验台操作员」（alice / p@ssw0rd）演示身份：
# - 本机演示（假上游 / 本机 Mininet）：true —— 预填 alice，直达 /scenario/simulator；
# - 真实部署：留空或 false —— 真实 IAM 只有 admin / tenantadmin 两个种子账号，
#   alice 没有对应实验室角色（见 docs/ai/lab-boundary.md 的 AssignRole 缺陷一节）。
NUXT_PUBLIC_DEMO_LAB_OPERATOR=false

