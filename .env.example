APPLE_DEVELOPMENT_TEAM="12345"

# ============================================================
# BFF（Nitro）—— 见 NMCPS-ADR-0007
# ============================================================
# 上游 REST 基址（server-only；不会进入浏览器产物）
# 联调实测实例：`http://192.168.1.55:10000/api/v1`（就绪探针 `/health` → `/api/v1/health`）
NUXT_BFF_UPSTREAM_BASE=http://192.168.1.55:10000/api/v1

# 单次上游请求超时（毫秒，默认 15000）
NUXT_BFF_TIMEOUT_MS=15000

# 允许携带凭据跨域访问 BFF 的 Origin（逗号分隔；桌面 WebView 为 tauri:// 协议）
NUXT_BFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,tauri://localhost,http://tauri.localhost

# 上游就绪探针（GET /ready）：拼接在 upstreamBase 之后的路径 + 独立超时（毫秒）
NUXT_BFF_READINESS_PATH=/health
NUXT_BFF_READINESS_TIMEOUT_MS=2000

# ============================================================
# 认证会话（见 NMCPS-ADR-0011）
# ============================================================
# 双 cookie 名：访问令牌（Path=/）+ 刷新令牌（Path=/api/auth，仅认证路由可见）
NUXT_BFF_TOKEN_COOKIE_NAME=nmcps_at
NUXT_BFF_REFRESH_COOKIE_NAME=nmcps_rt

# 令牌有效期兜底（毫秒）：访问令牌优先用上游 expiresIn；刷新令牌上游不返回 TTL
NUXT_BFF_ACCESS_TTL_MS=1800000
NUXT_BFF_REFRESH_TTL_MS=604800000

# 桌面端：请求带 `x-nmcps-client: desktop` 时 /api/auth/login|refresh 在响应体回传 tokens
# （存 tauri-plugin-store），否则写 HttpOnly cookie。该请求头已加入 CORS 白名单。

# 前端访问 BFF 的基址：
# - web（同源部署）：留空
# - 桌面构建：必须填已部署的 BFF，如 https://nmcps.example.com
NUXT_PUBLIC_BFF_BASE=

